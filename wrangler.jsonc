/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "djconnect-api",
	"main": "src/index.ts",
	"alias": {
	  "djc-existing-crypto": "./src/crypto.ts",
	  "djc-qualified-assertion": "./qualification/rendezvous/app-attest-core-candidate.mjs",
	  "djc-wire-schema": "./docs/rendezvous/wire-request-schemas-v1.json",
	  "djc-enrollment-trust": "./src/rendezvous/trust.ts"
	},
	"compatibility_date": "2026-06-20",
	"send_metrics": false,
	"triggers": {
		"crons": ["0 * * * *"]
	},
	"observability": {
		"enabled": true,
		"head_sampling_rate": 1
	},
	"upload_source_maps": true,
	"compatibility_flags": [
		"nodejs_compat"
	],
	"vars": {
		"APNS_TEAM_ID": "ZEML4LPXH4",
		"APNS_KEY_ID": "929NDF6UYK",
		"APNS_TOPIC_IOS": "dev.djconnect.ios",
		"APNS_TOPIC_MACOS": "dev.djconnect.mac",
		"APNS_TOPIC_WATCHOS": "dev.djconnect.ios.watch",
		"APNS_ENVIRONMENT": "sandbox",
		"RENDEZVOUS_PUBLIC_TRIAL_STARTS_AT": "1794313800000",
		"ASSERTION_POLICY_EXPIRES_AT": "1794319200000",
		"ASSERTION_POLICY_ENABLED": "ios-testflight/1",
		"RENDEZVOUS_TESTFLIGHT_MIN_BUILD": "40522",
		"RENDEZVOUS_TESTFLIGHT_MAX_BUILD": "40522",
		"RENDEZVOUS_TESTFLIGHT_RELEASE_REVISION": "1",
		"RENDEZVOUS_CAPACITY_POLICY": "private-household/1",
		"ENROLLMENT_POLICY_REVISION": "public-testflight-trial/1",
		"ALLOCATION_POLICY_ENABLED": "djc-allocation-qualification/1",
		"COMPOSED_POLICY_ENABLED": "djc-http-composition-qualification/1",
		"INDEX_POLICY_ENABLED": "djc-index-qualification/1",
		"REQUEST_POLICY_ENABLED": "djc-request-admission-qualification/2",
		"RENDEZVOUS_EDGE_POLICY": "djc-direct-edge-identity/1-candidate"
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "djconnect_api",
			"database_id": "476a564f-08b2-4966-83b0-1221e2a4d063",
			"migrations_dir": "migrations"
		}
	],
	"durable_objects": {
		"bindings": [
			{ "name": "REQUEST_ADMISSION", "class_name": "RequestAdmission" },
			{ "name": "ADMISSION_STATE", "class_name": "AllocationBudget" },
			{ "name": "ALLOCATION_INDEX", "class_name": "AllocationIndex" },
			{ "name": "ENROLLMENT_COORDINATOR", "class_name": "EnrollmentCoordinator" },
			{ "name": "COMPOSED_TRANSACTIONS", "class_name": "BudgetedTransactionCoordinator" }
		]
	},
	"migrations": [
		{
			"tag": "djc-rendezvous-sqlite-v1",
			"new_sqlite_classes": [
				"RequestAdmission",
				"AllocationBudget",
				"AllocationIndex",
				"EnrollmentCoordinator",
				"BudgetedTransactionCoordinator"
			]
		}
	],
	"routes": [
		{
			"pattern": "api.djconnect.dev",
			"custom_domain": true
		}
	]
	/**
	 * Smart Placement
	 * https://developers.cloudflare.com/workers/configuration/smart-placement/#smart-placement
	 */
	// "placement": {  "mode": "smart" }
	/**
	 * Bindings
	 * Bindings allow your Worker to interact with resources on the Cloudflare Developer Platform, including
	 * databases, object storage, AI inference, real-time communication and more.
	 * https://developers.cloudflare.com/workers/runtime-apis/bindings/
	 */
	/**
	 * Environment Variables
	 * https://developers.cloudflare.com/workers/wrangler/configuration/#environment-variables
	 * Note: Use secrets to store sensitive data.
	 * https://developers.cloudflare.com/workers/configuration/secrets/
	 */
	// "vars": {  "MY_VARIABLE": "production_value" }
	/**
	 * Static Assets
	 * https://developers.cloudflare.com/workers/static-assets/binding/
	 */
	// "assets": {  "directory": "./public/",  "binding": "ASSETS" }
	/**
	 * Service Bindings (communicate between multiple Workers)
	 * https://developers.cloudflare.com/workers/wrangler/configuration/#service-bindings
	 */
	// "services": [  {   "binding": "MY_SERVICE",   "service": "my-service"  } ]
}
